---
const values = [
  {
    title: 'Outcome-first, always',
    desc: 'We agree the target metric before we write a line of code — success is defined by your business, not our invoice.',
  },
  {
    title: 'Senior people only',
    desc: 'You work directly with experienced engineers and strategists — no hand-offs, no account-manager relay.',
  },
  {
    title: 'Plain-English communication',
    desc: 'Weekly updates you can actually read, tied to your numbers — what shipped, what the metric did, what happens next.',
  },
];

const facts = [
  { label: 'Founded', value: '2021' },
  { label: 'Projects delivered', value: '60+' },
  { label: 'Industries served', value: '12' },
  { label: 'Client retention', value: '94%' },
];
---

<section class="about section" id="about">
  <div class="container about__inner">
    <div class="about__copy">
      <span class="eyebrow">About us</span>
      <h2>A small team obsessed with results, not deliverables.</h2>
      <p class="lead">
        Built Outcomes was founded on a simple frustration: too many technology
        projects end with a handover, not a result. We're engineers and
        strategists who stay accountable to the business outcome — from the
        first workshop to the final report.
      </p>

      <ul class="about__values">
        {values.map((v) => (
          <li>
            <span class="about__check" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span class="about__value-body">
              <strong>{v.title}</strong>
              <span>{v.desc}</span>
            </span>
          </li>
        ))}
      </ul>

      <a href="/about" class="btn btn--ghost about__more">
        More about us
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
      </a>
    </div>

    <div class="about__panel">
      <div class="about__card">
        <div class="about__card-title">
          <img src="/logo.webp" alt="" width="22" height="22" />
          <span>Built Outcomes at a glance</span>
        </div>
        {facts.map((f) => (
          <div class="about__fact">
            <span>{f.label}</span>
            <strong>{f.value}</strong>
          </div>
        ))}
        <div class="about__fact about__fact--hl">
          <span>Every engagement</span>
          <strong>Measured &amp; reported</strong>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-surface);
  }

  .about__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (max-width: 900px) {
    .about__inner {
      grid-template-columns: 1fr;
    }
  }

  .about__copy > .eyebrow {
    margin-bottom: 1.25rem;
  }

  .about__copy .lead {
    margin-top: 1rem;
    max-width: 560px;
  }

  .about__values {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .about__values li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .about__check {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .about__value-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .about__value-body strong {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-fg);
  }

  .about__value-body > span {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 520px;
  }

  .about__more {
    margin-top: 1.75rem;
  }

  .about__panel {
    background: #fdf1e7;
    border-radius: 24px;
    padding: clamp(1.25rem, 3vw, 2.25rem);
  }

  .about__card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .about__card-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    font-size: 0.9375rem;
    color: var(--color-fg);
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 0.25rem;
  }

  .about__fact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.75rem;
    border-radius: 10px;
    background: var(--color-surface);
    font-size: 0.875rem;
  }

  .about__fact span {
    color: var(--color-muted);
    font-weight: 500;
  }

  .about__fact strong {
    font-weight: 700;
    color: var(--color-fg);
    font-variant-numeric: tabular-nums;
  }

  .about__fact--hl {
    background: var(--color-accent);
  }

  .about__fact--hl span,
  .about__fact--hl strong {
    color: #fff;
  }
</style>

---
const steps = [
  {
    n: '01',
    title: 'Discover — map your workflows and agree the target',
    desc: 'We start with a short discovery sprint: mapping how work actually flows through your business, which systems hold what, and where the friction is. Before anything gets built, we agree the outcome metric together — revenue, hours saved, response time, or conversion.',
    visual: 'connect',
  },
  {
    n: '02',
    title: 'Build & integrate — shipped in small increments',
    desc: "We design, build, and wire software and AI into the stack you already run — no rip-and-replace. Work ships in small increments, so you see something real every few weeks and can course-correct early instead of waiting for a big reveal.",
    visual: 'train',
  },
  {
    n: '03',
    title: 'Measure — track the metric we agreed together',
    desc: 'The outcome metric goes on a shared dashboard from day one. You watch it move as each increment lands — no guessing whether the project is working, no waiting until the end to find out.',
    visual: 'scorecard',
  },
  {
    n: '04',
    title: 'Improve & hand over — with a clear report',
    desc: "We tune what we've built until the metric holds, then hand everything over: a plain-English report on what changed and by how much, full documentation, and training for your team. You own all of it.",
    visual: 'progress',
  },
];
---

<section class="how section" id="how-it-works">
  <div class="container">
    <header class="section-header">
      <span class="eyebrow">How we work</span>
      <h2>From "we should automate this" to <em>measurable growth</em> — in weeks, not quarters.</h2>
    </header>

    <ol class="how__list">
      {steps.map((s, i) => (
        <li class={`step ${i % 2 === 1 ? 'step--reverse' : ''}`}>
          <div class="step__copy">
            <span class="step__num">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
          <div class="step__visual" aria-hidden="true">
            {s.visual === 'connect' && (
              <div class="vis-connect">
                <div class="vc-head">
                  <span class="vc-head-title">Your stack</span>
                  <span class="vc-head-status">
                    <span class="vc-head-dot"></span>
                    6 mapped
                  </span>
                </div>

                <div class="vc-group">
                  <span class="vc-group-label">Communication</span>
                  <div class="vc-pills">
                    <span class="vis-pill"><img src="/integrations/zoom.webp" alt="" loading="lazy" />Zoom</span>
                    <span class="vis-pill"><img src="/integrations/google-meet.webp" alt="" loading="lazy" />Google Meet</span>
                    <span class="vis-pill"><img src="/integrations/teams.webp" alt="" loading="lazy" />Teams</span>
                  </div>
                </div>

                <div class="vc-group">
                  <span class="vc-group-label">CRM &amp; email</span>
                  <div class="vc-pills">
                    <span class="vis-pill"><img src="/integrations/salesforce.webp" alt="" loading="lazy" />Salesforce</span>
                    <span class="vis-pill"><img src="/integrations/slack.webp" alt="" loading="lazy" />Slack</span>
                    <span class="vis-pill"><img src="/integrations/gmail.webp" alt="" loading="lazy" />Gmail</span>
                  </div>
                </div>

                <div class="vc-upcoming">
                  <div class="vc-up-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="18" rx="2"/>
                      <path d="M16 2v4"/>
                      <path d="M8 2v4"/>
                      <path d="M3 10h18"/>
                    </svg>
                  </div>
                  <div class="vc-up-body">
                    <span class="vc-up-label">Kickoff in 14 min</span>
                    <strong>Acme Logistics · Discovery sprint</strong>
                    <span class="vc-up-meta">
                      <img src="/integrations/zoom.webp" alt="" loading="lazy" />
                      Zoom · with your ops lead + 1
                    </span>
                  </div>
                </div>

                <div class="vis-status">
                  <span class="vis-dot"></span>
                  Outcome metric agreed · hours saved / week
                </div>
              </div>
            )}
            {s.visual === 'train' && (
              <div class="vis-train">
                <div class="vis-train__head">
                  <span class="vis-train__title">Build plan</span>
                  <span class="vis-train__meta">Shipping in increments</span>
                </div>
                <ul class="vis-train__list">
                  <li class="vis-train__item">
                    <span class="vis-train__check">✓</span>
                    <span class="vis-train__label">AI intake automation</span>
                    <span class="vis-train__status">Shipped</span>
                  </li>
                  <li class="vis-train__item">
                    <span class="vis-train__check">✓</span>
                    <span class="vis-train__label">CRM ↔ billing sync</span>
                    <span class="vis-train__status">Shipped</span>
                  </li>
                  <li class="vis-train__item">
                    <span class="vis-train__check">✓</span>
                    <span class="vis-train__label">Support desk triage</span>
                    <span class="vis-train__status">Shipped</span>
                  </li>
                  <li class="vis-train__item">
                    <span class="vis-train__check vis-train__check--pending"></span>
                    <span class="vis-train__label">Outcome dashboard</span>
                    <span class="vis-train__status vis-train__status--learning">In build…</span>
                  </li>
                </ul>
                <div class="vis-train__progress">
                  <span>Engagement progress</span>
                  <div class="bar bar--good"><span style="width:84%"></span></div>
                  <strong>84%</strong>
                </div>
              </div>
            )}
            {s.visual === 'scorecard' && (
              <div class="vis-report">
                <div class="vr-head">
                  <div>
                    <span class="vr-title">Outcome tracker</span>
                    <span class="vr-meta">Acme Logistics · Q3</span>
                  </div>
                  <span class="vr-time">Week 9 · updated today</span>
                </div>

                <div class="vr-grade">
                  <div class="vr-grade-ring">
                    <svg viewBox="0 0 100 100" class="vr-ring-svg">
                      <circle cx="50" cy="50" r="42" stroke-width="8" fill="none" class="vr-ring-bg" />
                      <circle cx="50" cy="50" r="42" stroke-width="8" fill="none"
                              stroke-dasharray="263.9" stroke-dashoffset="42"
                              stroke-linecap="round" transform="rotate(-90 50 50)"
                              class="vr-ring-fg" />
                    </svg>
                    <span class="vr-ring-letter">84%</span>
                  </div>
                  <div class="vr-grade-meta">
                    <span class="vr-grade-label">Target progress</span>
                    <strong class="vr-grade-score">15<em> hrs saved / wk</em></strong>
                    <span class="vr-grade-trend">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 14 12 8 18 14"/></svg>
                      Ahead of the agreed target
                    </span>
                  </div>
                </div>

                <div class="vr-metrics">
                  <div class="vr-metric">
                    <span class="vr-metric-label">Hours saved / week</span>
                    <span class="vr-grade-pill vr-grade-pill--a">A</span>
                    <strong>15</strong>
                  </div>
                  <div class="vr-metric">
                    <span class="vr-metric-label">Manual steps left</span>
                    <span class="vr-grade-pill vr-grade-pill--d">D</span>
                    <strong>6</strong>
                  </div>
                  <div class="vr-metric">
                    <span class="vr-metric-label">Response time</span>
                    <span class="vr-grade-pill vr-grade-pill--b">B</span>
                    <strong>−48%</strong>
                  </div>
                </div>

                <div class="vsc-tip">
                  <span class="vsc-tip__b">LIVE</span>
                  Wired into <img src="/integrations/salesforce.webp" alt="" class="vsc-tip__logo" loading="lazy" />Salesforce · CRM, billing &amp; support in one flow
                </div>
              </div>
            )}
            {s.visual === 'progress' && (
              <div class="vis-progress">
                <div class="vp-head">
                  <img class="vp-avatar" src="https://i.pravatar.cc/96?img=15" alt="" width="48" height="48" loading="lazy" />
                  <div class="vp-head-text">
                    <strong>Engagement review</strong>
                    <span>Acme Logistics · Ops team</span>
                  </div>
                  <span class="vp-period">Last 8 weeks</span>
                </div>

                <div class="vp-stats">
                  <div class="vp-stat">
                    <span class="vp-stat-label">Throughput</span>
                    <strong>+38%</strong>
                    <span class="vp-stat-trend">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 14 12 8 18 14"/></svg>
                      12%
                    </span>
                  </div>
                  <div class="vp-stat">
                    <span class="vp-stat-label">Hrs saved / wk</span>
                    <strong>15</strong>
                    <span class="vp-stat-trend">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 14 12 8 18 14"/></svg>
                      0.8
                    </span>
                  </div>
                  <div class="vp-stat">
                    <span class="vp-stat-label">Tasks automated</span>
                    <strong>47</strong>
                    <span class="vp-stat-trend">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 14 12 8 18 14"/></svg>
                      8
                    </span>
                  </div>
                </div>

                <div class="vp-chart">
                  <div class="vp-chart-head">
                    <span class="vp-chart-label">Outcome trend</span>
                    <span class="vp-chart-up">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 14 12 8 18 14"/></svg>
                      +24% vs last month
                    </span>
                  </div>
                  <svg viewBox="0 0 200 60" preserveAspectRatio="none" class="vp-chart-svg">
                    <path d="M0 50 L25 46 L50 42 L75 36 L100 30 L125 24 L150 16 L175 11 L200 6"
                          stroke="#22c55e" stroke-width="2.4" fill="none"
                          stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <div class="vp-chart-axis">
                    <span>W1</span><span>W2</span><span>W3</span><span>W4</span><span>W5</span><span>W6</span><span>W7</span><span>W8</span>
                  </div>
                </div>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how {
    background: #fff;
  }

  .how em {
    font-style: normal;
    color: var(--color-accent);
  }

  .how__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .step {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .step--reverse .step__copy { order: 2; }

  @media (max-width: 880px) {
    .step, .step--reverse .step__copy {
      grid-template-columns: 1fr;
      order: initial;
    }
  }

  .step__num {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 0.85rem;
  }

  .step__copy h3 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .step__copy p {
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .step__visual {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    box-shadow: var(--shadow-md);
    min-height: 280px;
  }

  /* Step 1 visual — connect */
  .vis-connect {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .vc-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .vc-head-title {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .vc-head-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-success);
  }

  .vc-head-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-success);
  }

  .vc-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .vc-group-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-muted);
    letter-spacing: 0.02em;
  }

  .vc-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .vc-upcoming {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 0.9rem;
    background: #fafbfd;
    border-radius: 12px;
    margin-top: 0.15rem;
  }

  .vc-up-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .vc-up-body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1;
    min-width: 0;
  }

  .vc-up-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .vc-up-body strong {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-fg);
    margin-top: 1px;
  }

  .vc-up-meta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.7rem;
    color: var(--color-muted);
    margin-top: 1px;
  }

  .vc-up-meta img {
    width: 12px;
    height: 12px;
    object-fit: contain;
  }

  .vis-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-fg);
    background: #fff;
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.75rem 0.35rem 0.45rem;
    border-radius: 999px;
  }

  .vis-pill img {
    width: 16px;
    height: 16px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .vis-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--color-success);
    font-weight: 600;
    padding: 0.6rem 0.85rem;
    background: rgba(16, 185, 129, 0.08);
    border-radius: 10px;
  }

  .vis-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-success);
  }

  /* Step 2 visual — training */
  .vis-train__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.85rem;
  }

  .vis-train__title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-fg);
  }

  .vis-train__meta {
    font-size: 0.7rem;
    color: var(--color-muted);
    font-weight: 500;
  }

  .vis-train__list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .vis-train__item {
    display: grid;
    grid-template-columns: 18px 1fr auto;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    background: #fafbfd;
    border-radius: 10px;
    font-size: 0.8125rem;
    color: var(--color-fg);
  }

  .vis-train__check {
    width: 18px;
    height: 18px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 800;
    color: #fff;
    background: var(--color-success);
  }

  .vis-train__check--pending {
    background: transparent;
    border: 2px solid var(--color-accent);
    box-sizing: border-box;
    animation: train-pulse 1.6s ease-in-out infinite;
  }

  @keyframes train-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .vis-train__status {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-success);
    letter-spacing: 0.02em;
  }

  .vis-train__status--learning { color: var(--color-accent); }

  .vis-train__progress {
    display: grid;
    grid-template-columns: 110px 1fr 36px;
    align-items: center;
    gap: 0.7rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-fg);
  }

  .vis-train__progress strong {
    text-align: right;
    font-weight: 700;
  }

  /* Step 3 visual — call report */
  .vr-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1rem;
  }

  .vr-title {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .vr-meta {
    display: block;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-fg);
    margin-top: 4px;
  }

  .vr-time {
    font-size: 0.7rem;
    color: var(--color-muted);
    font-weight: 500;
    text-align: right;
    flex-shrink: 0;
  }

  .vr-grade {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem;
    background: #fafbfd;
    border-radius: 14px;
    margin-bottom: 0.7rem;
  }

  .vr-grade-ring {
    position: relative;
    width: 70px;
    height: 70px;
    flex-shrink: 0;
  }

  .vr-ring-svg {
    width: 100%;
    height: 100%;
  }

  .vr-ring-bg {
    stroke: rgba(10, 26, 58, 0.08);
  }

  .vr-ring-fg {
    stroke: var(--color-success);
  }

  .vr-ring-letter {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-fg);
    letter-spacing: -0.04em;
  }

  .vr-grade-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .vr-grade-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .vr-grade-score {
    display: block;
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-fg);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-top: 3px;
  }

  .vr-grade-score em {
    font-style: normal;
    font-weight: 600;
    color: var(--color-muted);
    font-size: 0.875rem;
    margin-left: 1px;
  }

  .vr-grade-trend {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-success);
    margin-top: 6px;
  }

  /* Per-metric rows */
  .vr-metrics {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 0.7rem;
  }

  .vr-metric {
    display: grid;
    grid-template-columns: 1fr auto 38px;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.75rem;
    background: #fafbfd;
    border-radius: 8px;
    font-size: 0.8125rem;
  }

  .vr-metric-label {
    font-weight: 500;
    color: var(--color-fg);
  }

  .vr-metric strong {
    font-weight: 700;
    color: var(--color-fg);
    text-align: right;
  }

  .vr-grade-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.03em;
  }

  .vr-grade-pill--a { background: var(--color-success); }
  .vr-grade-pill--b { background: var(--color-accent); }
  .vr-grade-pill--c { background: var(--color-warning); }
  .vr-grade-pill--d { background: var(--color-danger); }

  .bar {
    height: 8px;
    border-radius: 999px;
    background: var(--color-surface-2);
    overflow: hidden;
  }

  .bar > span {
    display: block;
    height: 100%;
    background: var(--color-muted);
    border-radius: inherit;
  }

  .bar--good > span { background: var(--color-success); }
  .bar--ok > span { background: var(--color-warning); }
  .bar--bad > span { background: var(--color-danger); }

  .vsc-tip {
    margin-top: 1rem;
    padding: 0.85rem;
    border-radius: 10px;
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent-soft-hover);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-fg);
  }

  .vsc-tip__b {
    display: inline-block;
    margin-right: 0.5rem;
    font-size: 0.7rem;
    font-weight: 800;
    color: #fff;
    background: var(--color-accent);
    padding: 2px 7px;
    border-radius: 5px;
    letter-spacing: 0.04em;
    vertical-align: 1px;
  }

  .vsc-tip__logo {
    width: 14px;
    height: 14px;
    object-fit: contain;
    display: inline-block;
    vertical-align: middle;
    margin: 0 4px 0 2px;
  }

  /* Step 4 visual — personal progress */
  .vp-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .vp-avatar {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    object-fit: cover;
    flex-shrink: 0;

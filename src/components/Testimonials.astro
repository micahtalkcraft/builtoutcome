---
const quotes = [
  {
    quote: "They automated our whole intake process with AI in six weeks. We're saving around 15 hours a week and our response times have halved. First agency that actually reported back on the numbers.",
    name: 'Sarah Mitchell',
    role: 'Operations Director',
    company: 'Logistics',
    initials: 'SM',
    color: '#fbbf24',
  },
  {
    quote: "Our CRM, billing, and support tools finally talk to each other. No more copy-pasting between five tabs. The team explained everything in plain English the entire way through.",
    name: 'James Okafor',
    role: 'Founder',
    company: 'Prof. services',
    initials: 'JO',
    color: '#34d399',
  },
  {
    quote: "We'd been burned by big consultancies before. Built Outcomes agreed a target with us up front and beat it — 38% more throughput in one quarter. Easiest ROI conversation I've ever had.",
    name: 'Laura Price',
    role: 'COO',
    company: 'E-commerce',
    initials: 'LP',
    color: '#60a5fa',
  },
  {
    quote: "We agreed on one number — hours spent on month-end close. It went from nine days to three. Everything they built runs inside the tools we already had.",
    name: 'Tom Nguyen',
    role: 'Managing Partner',
    company: 'Accounting',
    initials: 'TN',
    color: '#a78bfa',
  },
  {
    quote: "Discovery took two weeks, the first automation shipped in week five, and we could see the metric moving from day one. No jargon, no surprise invoices.",
    name: 'Priya Shah',
    role: 'Head of Operations',
    company: 'Healthcare',
    initials: 'PS',
    color: '#fb923c',
  },
  {
    quote: "They connected our scheduling, invoicing, and CRM, then handed us the docs and trained the team. We own all of it — and our quote-to-invoice time dropped 60%.",
    name: 'Marcus Webb',
    role: 'CEO',
    company: 'Field services',
    initials: 'MW',
    color: '#f472b6',
  },
];
---

<section class="testimonials section" id="testimonials">
  <div class="container">
    <header class="section-header">
      <span class="eyebrow">Clients</span>
      <h2>Real outcomes, reported back.</h2>
      <p class="lead">Five-star reviews from businesses we've worked with — every result measured and reported.</p>
    </header>
  </div>

  <div class="t-carousel" data-viewport>
    <div class="t-carousel__track">
      {quotes.map((q) => (
        <article class="t-card">
          <blockquote>"{q.quote}"</blockquote>
          <footer>
            <div class="t-card__person">
              <span class="t-card__avatar" style={`background:${q.color}`}>{q.initials}</span>
              <div>
                <strong>{q.name}</strong>
                <span>{q.role}</span>
              </div>
            </div>
            <div class="t-card__company">{q.company}</div>
          </footer>
        </article>
      ))}
    </div>
  </div>

  <div class="container">
    <div class="t-nav">
      <button type="button" class="t-nav__btn t-nav__btn--ghost" data-prev aria-label="Previous testimonial">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button type="button" class="t-nav__btn t-nav__btn--accent" data-next aria-label="Next testimonial">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: #fff;
  }

  /* ──────────── Carousel viewport ──────────── */
  .t-carousel {
    overflow-x: auto;
    overflow-y: hidden;
    -ms-overflow-style: none;
    scrollbar-width: none;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    /* Match container padding so cards align with section header */
    scroll-padding-inline: clamp(1.25rem, 4vw, 2rem);
    padding-inline: clamp(1.25rem, 4vw, 2rem);
    max-width: calc(var(--container) + clamp(2.5rem, 8vw, 4rem));
    margin-inline: auto;
  }

  .t-carousel::-webkit-scrollbar {
    display: none;
  }

  .t-carousel__track {
    display: flex;
    gap: 1.25rem;
    /* Right-side "peek" handled by track being wider than viewport */
  }

  /* ──────────── Card ──────────── */
  .t-card {
    flex: 0 0 clamp(300px, 38vw, 500px);
    scroll-snap-align: start;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    min-height: 320px;
  }

  .t-card blockquote {
    margin: 0;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    flex: 1;
  }

  .t-card footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .t-card__person {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .t-card__avatar {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    color: #fff;
    font-weight: 700;
    font-size: 0.8125rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .t-card__person strong {
    display: block;
    font-weight: 700;
    color: var(--color-fg);
    font-size: 0.9375rem;
  }

  .t-card__person span {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .t-card__company {
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-subtle);
    flex-shrink: 0;
    text-align: right;
  }

  /* ──────────── Nav buttons ──────────── */
  .t-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }

  .t-nav__btn {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .t-nav__btn--ghost {
    background: #fff;
    border: 1px solid var(--color-border);
    color: var(--color-fg);
  }

  .t-nav__btn--ghost:hover {
    border-color: var(--color-fg);
    transform: translateY(-1px);
  }

  .t-nav__btn--accent {
    background: var(--color-accent);
    border: 0;
    color: #fff;
  }

  .t-nav__btn--accent:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  .t-nav__btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .t-carousel { scroll-behavior: auto; }
    .t-nav__btn { transition: none; }
  }
</style>

<script>
  const viewport = document.querySelector<HTMLElement>('[data-viewport]');
  const prev = document.querySelector<HTMLButtonElement>('[data-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-next]');

  if (viewport && prev && next) {
    const stepDistance = () => {
      const card = viewport.querySelector<HTMLElement>('.t-card');
      if (!card) return viewport.clientWidth * 0.5;
      // Card width + the gap from the flex container
      const styles = getComputedStyle(viewport.querySelector<HTMLElement>('.t-carousel__track')!);
      const gap = parseFloat(styles.gap) || 20;
      return card.offsetWidth + gap;
    };

    const updateButtons = () => {
      const max = viewport.scrollWidth - viewport.clientWidth - 4;
      prev.disabled = viewport.scrollLeft <= 4;
      next.disabled = viewport.scrollLeft >= max;
    };

    prev.addEventListener('click', () => {
      viewport.scrollBy({ left: -stepDistance(), behavior: 'smooth' });
    });

    next.addEventListener('click', () => {
      viewport.scrollBy({ left: stepDistance(), behavior: 'smooth' });
    });

    viewport.addEventListener('scroll', () => {
      // Throttle with rAF to avoid layout thrash on every scroll event
      requestAnimationFrame(updateButtons);
    });

    new ResizeObserver(updateButtons).observe(viewport);
    updateButtons();
  }
</script>

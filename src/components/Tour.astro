    .dash__board { grid-template-columns: repeat(2, 1fr); }
    .dash__search { display: none; }
  }
</style>

<script>
  // Accordion + rotating dashboard views.
  // The active tab, its matching .dash__view, and a sidebar highlight all move
  // together; auto-advances every 5s while the section is on screen, and a
  // manual click restarts the clock so it doesn't jump away from the reader.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tour-tab'));
  const views = Array.from(document.querySelectorAll<HTMLElement>('.dash__view'));
  const sideLinks = Array.from(document.querySelectorAll<HTMLElement>('.dash__sidebar a'));
  // step index → sidebar item (Projects, Outcomes, Team, Metrics, Integrations, Settings)
  const sideMap = [0, 0, 4, 1, 0, 3];

  let current = 0;
  let timer: ReturnType<typeof setInterval> | undefined;

  const activate = (i: number) => {
    current = i;
    tabs.forEach((t, j) => t.classList.toggle('is-active', j === i));
    views.forEach((v, j) => v.classList.toggle('is-active', j === i));
    sideLinks.forEach((a, j) => a.classList.toggle('is-active', j === sideMap[i]));
  };

  const startTimer = () => {
    clearInterval(timer);
    timer = setInterval(() => activate((current + 1) % tabs.length), 5000);
  };

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => {
      activate(i);
      startTimer();
    });
  });

  // Only rotate while the section is actually in view.
  const section = document.querySelector('#tour');
  if (section && tabs.length && views.length) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) startTimer();
        else clearInterval(timer);
      },
      { threshold: 0.25 }
    );
    io.observe(section);
  }
</script>

---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found | Built Outcomes"
  description="That page doesn't exist — head back to Built Outcomes to see how we integrate marketing, software, and AI into businesses."
>
  <Nav />
  <main>
    <section class="nf section">
      <div class="container nf__inner">
        <span class="nf__code">404</span>
        <h1>That page doesn't exist.</h1>
        <p class="lead">
          It may have moved while we rebuilt things. Here's where you probably
          want to go:
        </p>
        <div class="nf__links">
          <a href="/" class="btn btn--accent btn--lg">Back to home</a>
          <a href="/pricing" class="btn btn--ghost btn--lg">See pricing</a>
          <a href="/contact" class="btn btn--ghost btn--lg">Contact us</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .nf {
    background: #fff;
    min-height: 55vh;
    display: flex;
    align-items: center;
  }

  .nf__inner {
    text-align: center;
    max-width: 560px;
  }

  .nf__code {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .nf h1 {
    margin-bottom: 1rem;
  }

  .nf__links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>

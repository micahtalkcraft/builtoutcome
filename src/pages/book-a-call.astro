---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="Book a Free Strategy Call | Built Outcomes"
  description="Book a free 30-minute strategy call with Built Outcomes. No prep, no obligation — leave with an honest take on where software and AI will pay off first."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Book a call with Built Outcomes',
    url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}/book-a-call`,
    mainEntity: { '@id': `${Astro.site?.toString().replace(/\/$/, '') ?? ''}/#organization` },
  }}
>
  <Nav />
  <main>
    <PageHero
      title="Book a call."
      description="A free, no-obligation chat about what you want to grow, automate, or connect — pick a time below that suits you."
      flush
      tone="blue"
    />

    <section class="book section">
      <div class="container">

        <!-- ══════════════════════════════════════════════════════════════
             CALENDAR EMBED GOES HERE
             Replace the .book__placeholder div below with your calendar
             embed code (e.g. Calendly inline embed — the <div> + <script>
             snippet from Calendly › Share › Embed inline). The wrapper
             gives it the width and min-height most embeds need.
             ══════════════════════════════════════════════════════════════ -->
        <div class="book__embed">
          <div class="book__placeholder">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <strong>Calendar coming soon</strong>
            <p>In the meantime, email us and we'll find a time together.</p>
            <a href="mailto:micah@talkcraftai.com?subject=Book%20a%20call" class="btn btn--accent">Email micah@talkcraftai.com</a>
          </div>
        </div>

        <div class="book__points">
          <div class="book__point">
            <strong>30 minutes</strong>
            <span>Free, no obligation — just a conversation about your business.</span>
          </div>
          <div class="book__point">
            <strong>Come as you are</strong>
            <span>No prep needed. We'll ask about your tools, workflows, and goals.</span>
          </div>
          <div class="book__point">
            <strong>Leave with a plan</strong>
            <span>You'll get our honest take on where software and AI will pay off first.</span>
          </div>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .book {
    background: #fff;
    padding-top: clamp(1rem, 2vw, 1.5rem);
  }

  /* Wrapper sized for a typical inline calendar embed (Calendly ≈ 700px tall) */
  .book__embed {
    max-width: 900px;
    margin-inline: auto;
    min-height: 640px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
  }

  .book__embed > :global(*) {
    flex: 1;
  }

  .book__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
    padding: 2rem;
    background: var(--color-surface);
    color: var(--color-muted);
  }

  .book__placeholder svg {
    color: var(--color-accent);
  }

  .book__placeholder strong {
    font-size: 1.25rem;
    color: var(--color-fg);
    letter-spacing: -0.01em;
  }

  .book__placeholder p {
    max-width: 36ch;
  }

  .book__placeholder .btn {
    margin-top: 0.5rem;
  }

  .book__points {
    max-width: 900px;
    margin: 2rem auto 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 760px) {
    .book__points {
      grid-template-columns: 1fr;
    }
  }

  .book__point {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .book__point strong {
    font-size: 0.9375rem;
    color: var(--color-fg);
  }

  .book__point span {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
</style>

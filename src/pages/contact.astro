---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="Contact Us — Software, AI & Marketing Help | Built Outcomes"
  description="Questions about marketing, automation, or AI for your business? Email micah@talkcraftai.com — we reply within one business day. Get in touch today."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact Built Outcomes',
    url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}/contact`,
    mainEntity: { '@id': `${Astro.site?.toString().replace(/\/$/, '') ?? ''}/#organization` },
  }}
>
  <Nav />
  <main>
    <PageHero
      title="Get in touch."
      description="Tell us what you're trying to grow, automate, or untangle — we'll get back to you within one business day."
      flush
      tone="blue"
    />

    <section class="contact section">
      <div class="container">
        <div class="contact__card">
          <div class="contact__icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
          </div>
          <h2>Email us</h2>
          <p>The fastest way to reach us — a couple of sentences about your business and what you need is plenty.</p>
          <a href="mailto:micah@talkcraftai.com" class="contact__email">micah@talkcraftai.com</a>
          <a href="mailto:micah@talkcraftai.com" class="btn btn--accent btn--lg">Send an email</a>
        </div>

        <p class="contact__alt">
          Prefer to talk it through? <a href="/book-a-call">Book a call</a> and pick a time that suits you.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .contact {
    background: #fff;
    padding-top: clamp(1rem, 2vw, 1.5rem);
  }

  .contact__card {
    max-width: 560px;
    margin-inline: auto;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(2.25rem, 4vw, 3rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .contact__icon {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .contact__card h2 {
    font-size: 1.5rem;
  }

  .contact__card p {
    max-width: 40ch;
  }

  .contact__email {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: -0.01em;
  }

  .contact__email:hover {
    text-decoration: underline;
  }

  .contact__card .btn {
    margin-top: 0.5rem;
  }

  .contact__alt {
    text-align: center;
    margin-top: 2rem;
    color: var(--color-muted);
  }

  .contact__alt a {
    color: var(--color-accent);
    font-weight: 600;
  }

  .contact__alt a:hover {
    text-decoration: underline;
  }
</style>

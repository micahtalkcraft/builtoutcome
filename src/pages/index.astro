---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Mission from '../components/Mission.astro';
import Tour from '../components/Tour.astro';
import Features from '../components/Features.astro';
import Integrations from '../components/Integrations.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FinalCTA from '../components/FinalCTA.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Built Outcomes — Marketing, software & AI to grow your business"
  description="Built Outcomes helps businesses grow through marketing, software, and automations — integrating your tools, your information, and AI into one connected engine, with every engagement measured against an agreed growth target."
>
  <Nav />
  <main>
    <Hero />
    <Mission />
    <Tour />
    <HowItWorks />
    <Integrations />
    <Features />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
